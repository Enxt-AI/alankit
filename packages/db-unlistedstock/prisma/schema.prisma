// ============================================
// ACCOUNTING ENUMS
// ============================================
enum LedgerType {
  BANK
  USER
  STOCK // Auto-created per Stock, tracks stock quantity
  PURCHASE // System control account — accumulates all purchase voucher amounts (Dr)
  SALE // System control account — accumulates all sale voucher amounts (Cr)
}

enum VoucherType {
  PAYMENT_SALES
  RECEIPT
  JOURNAL
  STOCK_JOURNAL
  DEBIT_NOTE
  CREDIT_NOTE
}

enum EntryType {
  DEBIT
  CREDIT
}

// ============================================
// LEDGER MODEL - Bank & User Accounts
// ============================================
// Represents a financial account in the double-entry system.
// Type BANK: stores bank-specific fields (bankName, accountNumber, ifscCode).
// Type USER: stores user/party-specific fields (phone, email, pan).
model Ledger {
  id String @id @default(cuid())

  // Ledger identity
  name    String // e.g. "HDFC Bank Current A/C" or "Harish Chandra Jaiswal"
  code    String?    @unique // e.g. "UL0523A3F9KX2M", "BL0523B2C1D4E5"
  sunCode String?
  sunName String?
  type    LedgerType // BANK or USER

  // Linked user (1:1 — each user gets exactly one ledger, auto-created on full verification)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Linked stock (1:1 — each stock gets exactly one ledger, auto-created on stock creation)
  stockId String? @unique
  stock   Stock?  @relation(fields: [stockId], references: [id])

  // Balances
  openingBalance     Float  @default(0) // Balance at Financial Year start
  openingBalanceType String @default("DR") // DR or CR
  currentBalance     Float  @default(0) // Running balance (updated on voucher posting)

  // Bank-specific fields (nullable, used only when type = BANK)
  bankName      String? // e.g. "HDFC Bank"
  accountNumber String? // Bank account number
  ifscCode      String? // IFSC code

  // User/Party-specific fields (nullable, used only when type = USER)
  phone               String?
  email               String?
  pan                 String? // PAN number
  gstNo               String? // GST number
  tanNo               String? // TAN number
  dematAccountNo      String? // Client Demat account number
  clientBankAccountNo String? // Client's bank account number
  clientIfscCode      String? // Client's bank IFSC code

  // Common optional fields
  address  String?
  isActive Boolean @default(true)
  metadata Json? // Flexible extra fields

  // Group assignment (optional — Tally-style group classification)
  groupId String?
  group   AccountingGroup? @relation(fields: [groupId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  voucherEntries VoucherEntry[]

  @@index([type])
  @@index([isActive])
  @@index([name])
  @@index([createdAt])
}

// ============================================
// VOUCHER MODEL - Financial Transactions
// ============================================
// Represents a financial voucher/transaction.
// Each voucher must have balanced debit and credit entries (double-entry).
// Voucher is "posted" when isPosted = true, which locks the voucher
// and applies the balance changes to the associated ledgers.
model Voucher {
  id String @id @default(cuid())

  // Voucher identity
  voucherNumber String      @unique // Auto-generated: PAY-0001, RCP-0001, etc.
  type          VoucherType // PAYMENT_SALES, PAYMENT, RECEIPT, JOURNAL, CONTRA
  date          DateTime // Transaction date

  // Approval Lifecycle
  status         VoucherStatus @default(PENDING)
  approvedById   String? // Admin/PanelUser ID who approved or remarked
  approvedAt     DateTime? // Timestamp of the approval/remark action
  approvalRemark String?       @db.Text // Remark text (required when REMARKED)

  // Details
  narration   String? @db.Text // Description / memo
  totalAmount Float // Sum of one side (debit or credit, they must be equal)

  // Reference details
  referenceNumber String? // UTR No, Contract Note No, etc.
  referenceDate   DateTime? // UTR Date, Contract Advice Date, etc.

  // Voucher Metadata
  branch         String?
  vertical       String?
  employeeId     String?
  employeeName   String?
  subBrokerCode  String?
  subBrokerName  String?
  // Audit
  createdById    String // Admin ID who created the voucher
  updatedById    String? // Admin ID who updated/edited the voucher
  adjustmentType String? // BONUS, SPLIT, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT_IN, ADJUSTMENT_OUT

  // Flexible storage
  metadata Json? // Ref numbers, attachments, notes, etc.

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Custom Voucher Type Relation
  customTypeId String?
  customType   CustomVoucherType? @relation(fields: [customTypeId], references: [id])

  // Relations
  entries            VoucherEntry[]
  inventoryMovements InventoryMovement[]
  inventoryShortfalls InventoryShortfall[]
  inventoryLots      InventoryLot[]
  saleAllocations    InventoryLotAllocation[] @relation("SaleVoucherAllocation")
  cogsAllocations    InventoryLotAllocation[] @relation("CogsVoucherAllocation")

  @@index([type])
  @@index([date])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([voucherNumber])
  @@index([customTypeId])
  @@index([referenceNumber])
}

// ============================================
// VOUCHER ENTRY MODEL - Debit/Credit Line Items
// ============================================
// Each voucher has 2+ entries. In a valid voucher:
//   ∑ DEBIT amounts === ∑ CREDIT amounts
model VoucherEntry {
  id String @id @default(cuid())

  // Parent voucher
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  // Target ledger
  ledgerId String
  ledger   Ledger @relation(fields: [ledgerId], references: [id])

  // Entry details
  entryType EntryType // DEBIT or CREDIT
  amount    Float // Always positive
  narration String? // Optional line-level narration

  // Stock/Script details (for sale/purchase vouchers)
  scriptName String? // e.g. "NSE Ltd"
  isin       String? // e.g. "INE721I01024"
  qty        Int? // Quantity
  rate       Float? // Rate per unit

  // Additional
  remarks  String? @db.Text // Extra remarks
  metadata Json? // Flexible storage for row-level details (Order ID, Mode of Payment, Sub Ledger, etc.)

  // Timestamp
  createdAt DateTime @default(now())

  @@index([ledgerId])
  @@index([entryType])
}

// ============================================
// COUPON MODEL - RM Generated Discounts
// ============================================
model Coupon {
  id   String @id @default(cuid())
  code String @unique

  // Relations
  internalRmId String?
  internalRm   InternalRM? @relation(fields: [internalRmId], references: [id])

  distributorRmId String?
  distributorRm   DistributorRM? @relation(fields: [distributorRmId], references: [id])

  stockId String // The specific stock this applies to
  stock   Stock  @relation(fields: [stockId], references: [id])

  assignedUserId String? // Optional: If tied to a specific user
  assignedUser   User?   @relation("AssignedCoupons", fields: [assignedUserId], references: [id])

  // Rules
  minQuantity        Int // Minimum number of shares required
  maxQuantity        Int // Maximum number of shares allowed
  discountAmount     Float // Fixed discount amount to apply (for FIXED type) or computed snapshot (for PERCENTAGE type)
  discountType       String @default("FIXED") // "FIXED" or "PERCENTAGE"
  discountPercentage Float? // Percentage discount (0.01 - 100). Only used when discountType = "PERCENTAGE"
  lendingPrice       Float? // Historical Lending Price Floor Snapshot (frozen at coupon generation)

  // Status
  isUsed Boolean   @default(false)
  usedAt DateTime?

  usedByUserId String? // The user who actually used it
  usedByUser   User?   @relation("UsedCoupons", fields: [usedByUserId], references: [id])

  orderId String? @unique // Link to the order it was used on
  order   Order?  @relation(fields: [orderId], references: [id])

  expiresAt DateTime? // Expiration date

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([internalRmId])
  @@index([distributorRmId])
  @@index([stockId])
  @@index([isUsed])
}

// ============================================
// LOGS & HISTORY
// ============================================

model LoginHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress  String
  deviceInfo String?
  location   String?
  loginAt    DateTime @default(now())

  @@index([userId])
  @@index([loginAt])
}

// ============================================
// E-SIGN ATTEMPTS (first-class log of every Digitap session)
// Captures sign-first sessions that never become Orders so e-sign
// dropouts (initiated but never signed) are visible in marketing.
// Status: INITIATED | SIGNED | CANCELLED | MISMATCH | FAILED | EXPIRED
// ============================================
model EsignAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  docId String @unique

  stockId  String?
  basketId String?
  stockName String?
  quantity Int     @default(1)
  pricePerShare Float?
  totalAmount   Float?

  orderId String?

  status String @default("INITIATED")

  intent Json?

  signedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([docId])
  @@index([orderId])
}

// ============================================
// E-SIGN TEMPLATES
// ============================================
model ESignTemplate {
  id         String  @id @default(cuid())
  templateId String // External template ID used in e-sign API requests
  pdfUrl     String? // MinIO URL of the PDF document to be signed

  // Audit Trail
  createdById String
  createdBy   Admin  @relation("ESignTemplateCreatedBy", fields: [createdById], references: [id])

  // Status
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ============================================
// VOUCHER STATUS LIFECYCLE
// ============================================
enum VoucherStatus {
  PENDING // Created, awaiting approval
  APPROVED // Approved — counts in books
  REMARKED // Rejected with a note
}

// ============================================
// ACCOUNTING GROUP (Tally-style)
// ============================================
model AccountingGroup {
  id               String   @id @default(cuid())
  name             String
  code             String?  @unique
  alias            String?
  under            String // Parent group e.g. "Capital Account"
  isSublLedger     Boolean  @default(false) // Behaves like sub-ledger
  nettBalance      Boolean  @default(false) // Nett Dr/Cr balances for reporting
  usedForCalc      Boolean  @default(false) // Used for calculation (taxes/discounts)
  allocationMethod String   @default("Not Applicable") // Not Applicable | Quantity | Value
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Ledgers assigned to this group
  ledgers Ledger[]

  @@index([under])
  @@index([createdAt])
}

// ============================================
// CUSTOM VOUCHER TYPE MODEL (Tally-style sub-types)
// ============================================
model CustomVoucherType {
  id            String      @id @default(cuid())
  name          String      @unique // e.g. "GST Sales", "Petty Cash"
  baseType      VoucherType // PAYMENT_SALES, RECEIPT, JOURNAL
  prefix        String? // e.g. "GSTS-" or "PC-"
  needsApproval Boolean     @default(true) // Dynamic opt-out of audit approvals
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  vouchers      Voucher[]

  @@index([isActive])
  @@index([baseType])
}

// ============================================
// ACCOUNTING PERIOD MODEL (Tally-style Lock Period)
// ============================================
model AccountingPeriod {
  id            String    @id @default(cuid())
  name          String // e.g. "FY 2026-27"
  startDate     DateTime // Financial year start date
  endDate       DateTime // Financial year end date
  lockStartDate DateTime? // Lock range start date (optional)
  lockEndDate   DateTime? // Lock range end date (optional)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive])
}

// ============================================
// SUN ACCOUNT MODEL (Database-backed Sun Mappings)
// ============================================
model SunAccount {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "STOCKBSRP"
  name      String // e.g. "Closing Stocks-BS (Retail Platform)"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

// ============================================
// INVENTORY MOVEMENT MODEL (Audit log of stock quantities)
// ============================================
model InventoryMovement {
  id           String    @id @default(cuid())
  stockId      String
  stock        Stock     @relation(fields: [stockId], references: [id])
  voucherId    String?
  voucher      Voucher?  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  qty          Int
  rate         Float?
  type         String // BONUS, SPLIT, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT_IN, ADJUSTMENT_OUT, PURCHASE, SALE, etc.
  snapshotDate DateTime?
  createdAt    DateTime  @default(now())
  createdById  String

  @@index([stockId])
  @@index([voucherId])
  @@index([stockId, snapshotDate(sort: Desc)])
}

// ============================================
// STOCK INTEREST MODEL - Captures out-of-stock user interest
// ============================================
model StockInterest {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockId           String
  stock             Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  requestedQuantity Int? // The quantity the user originally wanted to buy
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, stockId])
  @@index([userId])
  @@index([stockId])
}

// ============================================
// REVENUE SHARING SETTINGS MODEL
// ============================================
model RevenueShareSetting {
  id                  String   @id @default(cuid())
  type                String   @unique // "INTERNAL" or "EXTERNAL"
  revenuePercentage   Float    @default(0) // Revenue share percentage (0-100)
  incentivePercentage Float    @default(0) // Incentive percentage (0-100, relevant for INTERNAL)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ============================================
// MAKER-CHECKER APPROVAL REQUEST MODEL
// ============================================
model ChangeRequest {
  id         String  @id @default(cuid())
  entityType String // "STOCK_PRICING", "REVENUE_SHARING"
  entityId   String? // The ID of the Stock or RevenueShareSetting (if applicable)

  // The proposed changes as a JSON object
  proposedData Json

  // Who made the request
  requestedById String
  requestedBy   Admin  @relation("RequestedBy", fields: [requestedById], references: [id])

  status String @default("PENDING") // PENDING, APPROVED, REJECTED

  // Who reviewed it (Super Admin)
  reviewedById String?
  reviewedBy   Admin?  @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewNote   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([entityType])
  @@index([requestedById])
}

// ============================================
// SELL REQUEST MODEL
// ============================================
enum SellRequestStatus {
  PENDING
  UNDER_REVIEW
  CONTACTED
  NEGOTIATING
  ACCEPTED
  REJECTED
}

model SellRequest {
  id String @id @default(cuid())

  // User who wants to sell
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stock they want to sell (must be a listed stock)
  stockId String
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)

  // Sell details
  quantity      Int // Number of shares user wants to sell
  pricePerShare Float // Price per share user is asking for
  totalAmount   Float // quantity × pricePerShare (computed on server)

  // Lifecycle
  status    SellRequestStatus @default(PENDING)
  adminNote String?           @db.Text // Internal operations note

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([stockId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// CASHFREE RECONCILIATION RUN MODEL
// ============================================
model ReconciliationRun {
  id         String   @id @default(cuid())
  runDate    DateTime
  executedAt DateTime @default(now())
  executedBy String   @default("SYSTEM")
  status     String   @default("COMPLETED")

  totalTransactions Int @default(0)
  reconciledCount   Int @default(0)
  failedCount       Int @default(0)
  missingCashfree   Int @default(0)
  missingLocal      Int @default(0)

  reportData Json?
  summary    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runDate])
  @@index([executedAt])
}

// ============================================
// PERPETUAL INVENTORY (FIFO COGS) MODELS
// ============================================

enum InventoryLotStatus {
  ACTIVE
  EXHAUSTED
  CANCELLED
}

enum AllocationStatus {
  ACTIVE
  REVERSED
}

// Uncosted sales waiting for a later purchase, settled at actual purchase cost.
model InventoryShortfall {
  id            String   @id @default(cuid())
  stockId       String
  stock         Stock    @relation(fields: [stockId], references: [id])
  saleVoucherId String
  saleVoucher   Voucher  @relation(fields: [saleVoucherId], references: [id])
  remainingQty  Decimal
  saleDate      DateTime
  createdAt     DateTime @default(now())

  @@unique([stockId, saleVoucherId])
  @@index([stockId, saleDate, createdAt, id])
}

model InventoryLot {
  id           String             @id @default(cuid())
  stockId      String
  stock        Stock              @relation(fields: [stockId], references: [id])
  voucherId    String
  voucher      Voucher            @relation(fields: [voucherId], references: [id])
  purchaseDate DateTime // Effective date for deterministic FIFO ordering
  originalQty  Decimal
  remainingQty Decimal
  unitCost     Decimal
  status       InventoryLotStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  allocations InventoryLotAllocation[]

  @@index([stockId])
  @@index([voucherId])
  @@index([stockId, status, purchaseDate, createdAt, id]) // Optimized for FIFO selection
}

model InventoryLotAllocation {
  id            String           @id @default(cuid())
  lotId         String
  lot           InventoryLot     @relation(fields: [lotId], references: [id])
  saleVoucherId String
  saleVoucher   Voucher          @relation("SaleVoucherAllocation", fields: [saleVoucherId], references: [id])
  cogsVoucherId String
  cogsVoucher   Voucher          @relation("CogsVoucherAllocation", fields: [cogsVoucherId], references: [id])
  qtyConsumed   Decimal
  unitCost      Decimal // Copied from InventoryLot for historical safety
  cogsAmount    Decimal
  status        AllocationStatus @default(ACTIVE)
  createdAt     DateTime         @default(now())

  @@index([lotId])
  @@index([saleVoucherId])
  @@index([cogsVoucherId])
}

// ============================================
// CASHFREE SETTLEMENT RECONCILIATION
// ============================================

model CashfreeSettlement {
  id             String   @id @default(cuid())
  utrNumber      String   @unique
  settlementId   String?  @unique
  grossAmount    Decimal
  feeAmount      Decimal
  netAmount      Decimal
  paymentDate    DateTime // The date the original transaction occurred (e.g. 31-Jul)
  settlementDate DateTime // The date Cashfree deposited to HDFC (e.g. 01-Aug)
  voucherId      String?  @unique
  createdAt      DateTime @default(now())

  @@index([paymentDate])
  @@index([settlementDate])
}

// ============================================
// CAROUSEL MEDIA MODEL - App Carousel (Images/Videos/GIFs)
// ============================================
model CarouselMedia {
  id String @id @default(cuid())

  // Media details
  title       String   // Display title (e.g. "Summer Sale", "New Stock Alert")
  description String?  // Optional short description / caption
  mediaType   String   // IMAGE | VIDEO | GIF
  mediaUrl    String   // Storage URL (MinIO path e.g. /storage/carousel/...)
  thumbnailUrl String? // Optional thumbnail for videos
  linkUrl     String?  // Optional deep-link URL (e.g. stock page, offer page)
  linkType    String?  // Optional link type: STOCK | ARTICLE | NEWS | URL | NONE

  // Display control
  displayOrder Int     @default(0) // Lower = shown first in carousel
  isActive     Boolean @default(true) // Toggle visibility

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@index([createdAt])
}
