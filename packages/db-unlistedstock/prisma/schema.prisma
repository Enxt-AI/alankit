// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ============================================
// USER MODEL - Customers (Stock Buyers)
// ============================================
model User {
  id String @id @default(cuid())

  // Authentication
  email     String? @unique /// @encrypted
  emailHash String? @unique /// @encryption:hash(email)
  fullName  String?
  phone     String? @unique /// @encrypted
  phoneHash String? @unique /// @encryption:hash(phone)
  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  // KYC Information
  kycStatus String @default("PENDING") // PENDING, VERIFIED, REJECTED

  // KYC Progress Tracking (Phase 2 - Mock Mode)
  // kycData structure:
  // {
  //   panDetails: { pan: string, name: string, dob: string, verified: boolean },
  //   aadhaarDetails: { aadhaar: string, verified: boolean, otpSent: boolean },
  //   bankDetails: { accountNumber: string, ifsc: string, accountHolder: string, verified: boolean },
  //   documentsUploaded: { pan: boolean, aadhaar: boolean, bank: boolean },
  //   lastUpdatedStep: timestamp,
  //   submittedAt: timestamp (when final submission happens)
  // }
  kycData Json? // Stores KYC form progress and sub-step tracking

  // Demat Account Integration (Phase 4 - Mock Mode)
  // dematData structure:
  // {
  //   type: 'link',
  //   accountNumber: string (16-digit BO ID),
  //   dpId: string (8-digit),
  //   clientId: string (optional),
  //   panNumber: string (pre-filled from KYC),
  //   name: string,
  //   mobile: string,
  //   email: string,
  //   lastUpdatedAt: timestamp,
  //   submittedAt: timestamp (when final submission happens)
  // }
  dematData Json? // Stores Demat form data (link type)

  // dematDocuments structure:
  // {
  //   dematStatement: { data: string (base64), uploadedAt: timestamp, fileName: string, fileSize: number },
  // }
  dematDocuments Json? // Stores document uploads as base64 (local storage)

  // Demat Account Status
  dematStatus String @default("PENDING") // PENDING, VERIFIED

  // Bank Verification Integration
  // bankData structure:
  // {
  //   ifsc: string,
  //   accNo: string,
  //   benificiaryName: string,
  //   lastUpdatedAt: timestamp,
  //   submittedAt: timestamp
  // }
  bankData                    Json? // Stores Bank verification data
  bankStatus                  String     @default("PENDING") // PENDING, VERIFIED, REJECTED
  lastBankVerificationAttempt DateTime? // Enforces 1 attempt per 24 hours
  successfulBankVerifications DateTime[] // Enforces max 3 verified accounts per 12 months

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - Add these to fix the error
  orders         Order[]
  portfolio      Portfolio[]
  watchlistItems WatchlistItem[]
  notifications  Notification[]
  contentLikes   ContentLike[]

  // Relations
  kycDocuments KycDocument[]
  loginHistory LoginHistory[]
  ledger       Ledger?

  // Coupon System Relations
  assignedCoupons Coupon[] @relation("AssignedCoupons")
  usedCoupons     Coupon[] @relation("UsedCoupons")

  hashedRefreshToken String?

  stockInterests StockInterest[]
  sellRequests   SellRequest[]
  esignAttempts  EsignAttempt[]

  @@index([email])
  @@index([phone])
  @@index([kycStatus])
  @@index([dematStatus])
  @@index([phone, email]) // Optimize phone-first lookups
}

// ============================================
// KYC DOCUMENT MODEL - Individual KYC Documents from DigiLocker
// ============================================
// Each document fetched from DigiLocker (Aadhaar XML, PAN PDF, PAN XML,
// DigiLocker Summary PDF) is stored as a separate row for independent
// querying, audit, and admin review.
model KycDocument {
  id String @id @default(cuid())

  // User relation
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Document identity
  docType      String // AADHAAR, PANCR, DIGILOCKER_PDF
  docExtension String // xml, pdf
  docLink      String @db.Text // S3 pre-signed URL or permanent link

  // Status tracking
  status String @default("FETCHED") // FETCHED, EXPIRED, FAILED

  // Metadata
  fetchedAt DateTime  @default(now())
  expiresAt DateTime? // URL expiry (pre-signed URLs have a TTL)
  metadata  Json? // Any extra info (file size, hash, etc.)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([docType])
  @@index([userId, docType])
  @@index([status])
}

// ============================================
// NOTIFICATION MODEL - User Notifications
// ============================================
model Notification {
  id String @id @default(cuid())

  // User relation
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification content
  type    String // ORDER_PLACED, ORDER_COMPLETED, KYC_VERIFIED, BASKET_CREATED, etc.
  title   String
  message String @db.Text

  // Metadata (flexible JSON storage)
  // Structure: { redirectUrl?, orderId?, basketId?, basketSlug?, stockId?, amount?, stockName?, basketName?, ... }
  metadata Json?

  // Status
  isRead Boolean @default(false)

  // Timestamps
  createdAt DateTime  @default(now())
  readAt    DateTime? // When user marked as read

  // Indexes for performance
  @@index([userId, isRead]) // Fast unread queries
  @@index([userId, createdAt]) // Fast recent queries
  @@index([createdAt]) // Fast cleanup queries
}

// ============================================
// ADMIN MODEL - Employees (Platform Managers)
// ============================================

enum AdminRole {
  ADMIN
  SUPER_ADMIN
  CONTENT_MANAGER
  SUPPORT_AGENT
  MARKETING_MANAGER
  ACCOUNTANT
  OPERATIONS
  SALES_EMPLOYEE
}

enum BasketStatus {
  DRAFT
  OPEN
  CLOSED
  COMING_SOON
}

enum DocumentType {
  ANNUAL
  QUARTERLY
  RESEARCH
}

model Admin {
  id String @id @default(cuid())

  // Authentication
  email        String  @unique
  phone        String? @unique // Optional phone number
  fullName     String
  passwordHash String  // Bcrypt hashed password

  // Role & Permissions
  role        AdminRole @default(ADMIN) // ADMIN, SUPER_ADMIN, CONTENT_MANAGER
  permissions String[] // Array of permission strings

  // Status
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  availability      String  @default("available")
  availabilityNote  String?
  activeTicketCount Int     @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - Add these to fix the error
  stocksCreated         Stock[]         @relation("CreatedBy")
  stocksUpdated         Stock[]         @relation("UpdatedBy")
  // Upcoming stocks use separate relations to avoid ambiguity with Stock audit trail.
  // These power CMS/admin attribution for the Upcoming Stocks tab.
  upcomingStocksCreated UpcomingStock[] @relation("UpcomingStockCreatedBy")
  upcomingStocksUpdated UpcomingStock[] @relation("UpcomingStockUpdatedBy")
  basketsCreated        StockBasket[]   @relation("BasketCreatedBy")
  basketsUpdated        StockBasket[]   @relation("BasketUpdatedBy")
  eSignTemplates        ESignTemplate[] @relation("ESignTemplateCreatedBy")

  hashedRefreshToken String?
  assignedLeads      MarketingLead[] @relation("AssignedLeads")
  requestedChanges   ChangeRequest[] @relation("RequestedBy")
  reviewedChanges    ChangeRequest[] @relation("ReviewedBy")

  @@index([email])
  @@index([isActive])
  @@index([role])
}

// ============================================
// STOCK MODEL - Unlisted Stocks
// ============================================
// ==========================================
// Stock Category Model
// ==========================================
model StockCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  // Relations
  stocks Stock[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stock {
  id String @id @default(cuid())

  // Stock Details
  name                    String
  price                   Float
  minimumPurchaseQuantity Int?
  maximumPurchaseQuantity Int?
  // Slab-based quantity discount rules.
  // Shape: [{ minQty: number, pricePerShare: number }, ...]
  // Slabs are applied by the service layer: the highest `minQty` <= order quantity wins.
  // If no slab matches, the base `price` is used.
  discountSlabs           Json?
  // Lending price floors (per-share). Coupons cannot bring effective price below these.
  // Internal = 's own RMs; External = Distributor RMs
  internalLendingPrice    Float?
  externalLendingPrice    Float?
  logoUrl                 String?
  tags                    String[] // Array of tags for categorization
  categoryId              String? // Relation to StockCategory
  category                StockCategory? @relation(fields: [categoryId], references: [id])
  isin                    String? // ISIN code (International Securities Identification Number)
  // SEO
  slug                    String?        @unique // Custom URL slug (mandatory in app layer)
  companyOverview         String?        @db.Text // Detailed company information for SEO and UI

  // CIN is the sole business identifier for stocks.
  // It is mandatory, unique, and treated as immutable by the service layer.
  cin             String  @unique // CIN (Corporate Identification Number)
  pan             String? // Company PAN number
  totalShares     Float? // Total number of shares outstanding
  // Inventory: updated by accounting purchase (+) and sale (-) vouchers via ISIN match
  stockQuantity   Int     @default(0)
  // Backup / buffer quantity set by Operations when physical inventory is 0
  backupQuantity  Int     @default(0)
  openingQuantity Int     @default(0)
  openingRate     Float   @default(0)
  openingValue    Float   @default(0)
  isActive        Boolean @default(true)
  // NEW: Popular stock classification (drives the "Popular" tab on the client)
  isPopular       Boolean @default(false)
  // NEW: Market Movers classification (drives future client-side Market Movers filtering)
  isMarketMover   Boolean @default(false)

  // Audit Trail - Track which admin created/updated
  createdById String
  createdBy   Admin   @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?  @relation("UpdatedBy", fields: [updatedById], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders             Order[]
  basketConstituents BasketConstituent[]
  watchlistedBy      WatchlistItem[]
  portfolioItems     Portfolio[]
  news               News[]
  articles           Article[]
  faqs               Faq[]

  // Relations
  prices StockPrice[]

  // Accounting — 1:1 ledger auto-created on stock creation
  ledger Ledger?

  // Coupons
  coupons Coupon[]

  inventoryMovements InventoryMovement[]
  inventoryShortfalls InventoryShortfall[]
  inventoryLots      InventoryLot[]
  interests          StockInterest[]
  sellRequests       SellRequest[]

  @@index([isActive])
  // Popular-tab filtering frequently queries this field.
  @@index([isPopular])
  // Market Movers filtering follows the same client-side pattern as Popular.
  @@index([isMarketMover])
  @@index([createdById])
  @@index([isin])
}

// ============================================
// STOCK PRICE MODEL - Historical Stock Prices
// ============================================
model StockPrice {
  id        String   @id @default(cuid())
  stockId   String
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  price     Float
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stockId, date])
  @@index([stockId])
  @@index([date])
}

// ============================================
// UPCOMING STOCK MODEL - Upcoming/Pre-listing Stocks
// NOTE:
// - These models intentionally mirror the core Stock/StockDocument structure.
// - They allow us to curate "Upcoming" stocks separately, without mixing with live stocks.
// - App-level logic should ensure UpcomingStock is surfaced in the Upcoming tab, while Stock
//   (optionally filtered by isPopular) powers the Popular tab.
// ============================================
model UpcomingStock {
  id String @id @default(cuid())

  // Stock Details (same as Stock model)
  name        String
  price       Float
  logoUrl     String?
  tags        String[]
  isin        String?
  // CIN is the sole business identifier for upcoming stocks as well.
  // Using the same invariant here keeps conversion logic deterministic.
  cin         String   @unique // CIN (Corporate Identification Number)
  totalShares Float?
  isActive    Boolean  @default(true)
  // For conversion purposes (defaults to false; typically not exposed in CMS)
  isPopular   Boolean  @default(false)

  // Audit Trail
  createdById String
  createdBy   Admin   @relation("UpcomingStockCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?  @relation("UpcomingStockUpdatedBy", fields: [updatedById], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  watchlistedBy WatchlistItem[]

  @@index([isActive])
  @@index([createdById])
  @@index([isin])
}

model StockBasket {
  id String @id @default(cuid())

  // Basket Details
  name        String
  slug        String  @unique
  description String? @db.Text
  category    String // e.g., "High Growth", "Balanced", "Defensive"
  iconUrl     String?

  // Status Management
  status                BasketStatus @default(DRAFT)
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?

  // Investment Details
  minInvestment      Float
  priceEffectiveDate DateTime @default(now())

  // Active Status
  isActive Boolean @default(true)

  // Audit Trail - Track which admin created/updated
  createdById String
  createdBy   Admin   @relation("BasketCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   Admin?  @relation("BasketUpdatedBy", fields: [updatedById], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  constituents BasketConstituent[]
  orders       Order[]

  @@index([slug])
  @@index([isActive])
  @@index([status])
  @@index([category])
  @@index([createdById])
}

model BasketConstituent {
  id String @id @default(cuid())

  // Relations
  basketId String
  basket   StockBasket @relation(fields: [basketId], references: [id], onDelete: Cascade)
  stockId  String
  stock    Stock       @relation(fields: [stockId], references: [id])

  // Weight Details
  weight Float // Percentage weight (0-100)

  // Timestamp
  createdAt DateTime @default(now())

  @@unique([basketId, stockId])
  @@index([basketId])
  @@index([stockId])
}

// ============================================
// ORDER MODEL - User Stock Orders
// ============================================
// ============================================
// ORDER MODEL - User Stock Orders
// Status Flow: PENDING → PAID → ALLOCATED → COMPLETED
// Payment Flow: PENDING → PROCESSING → PAID (tracked separately)
// 
// Phase 3 Enhancement: Added Cashfree payment tracking fields
// - cashfreeOrderId: Cashfree order ID
// - cashfreePaymentId: Cashfree payment ID
// - paymentStatus: Tracks payment state (independent of order status)
// - paymentData: Stores payment metadata (JSON)
// ============================================
model Order {
  id String @id @default(cuid())

  // Generated Identifiers
  orderNumber   String? @unique
  invoiceNumber String? @unique
  receiptNumber String? @unique

  // Admin Manual Approval
  shareTransferReferenceNo String?
  shareTransferDate        DateTime?
  batchSequence            String?

  // Order Details
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  stockId String?
  stock   Stock?  @relation(fields: [stockId], references: [id])

  // Basket Order Support (optional - either stockId or basketId must be present)
  // IMPORTANT: Database-level CHECK constraint ensures exactly ONE of stockId or basketId is non-null
  // Constraint: Order_stock_or_basket_check enforces (stockId XOR basketId)
  basketId           String?
  basket             StockBasket? @relation(fields: [basketId], references: [id])
  basketConstituents Json? // Stores snapshot of basket constituents at order time

  quantity      Int
  pricePerShare Float
  totalAmount   Float

  // Coupons
  couponId            String?
  coupon              Coupon?
  discountApplied     Float   @default(0)
  originalTotalAmount Float?

  // Order Status
  status String @default("PENDING") // PENDING, PAID, ALLOCATED, COMPLETED, CANCELLED, EXPIRED

  // Inventory Reservation Expiration
  expiresAt DateTime?

  // Payment Integration (Cashfree)
  // Cashfree order ID generated when payment is initiated
  cashfreeOrderId   String?
  // Cashfree payment ID received after successful payment
  cashfreePaymentId String?
  // Payment status tracking (separate from order status)
  // PENDING = Payment not initiated
  // PROCESSING = Payment initiated, awaiting confirmation
  // PAID = Payment verified successfully
  // FAILED = Payment failed or cancelled
  paymentStatus     String  @default("PENDING")

  // Payment metadata storage
  // paymentData structure:
  // {
  //   gateway: 'cashfree',
  //   paymentTimestamp: timestamp,
  //   cashfreePaymentId: string,
  //   amount: number,
  //   currency: string (INR),
  //   errorCode?: string (if payment failed),
  //   errorDescription?: string (if payment failed),
  //   mockMode: boolean (true if mock payment)
  // }
  paymentData Json?

  // Payment attempts explicitly track multiple Cashfree sessions
  paymentAttempts PaymentAttempt[]

  // eSign Integration (Digitap)
  // Tracking signatures captured before cashfree initialization (required for purchase)
  esignDocId  String?
  esignStatus String  @default("PENDING") // PENDING, SIGNED, FAILED, MISMATCH

  // eSign Identity Validation (Aadhaar signer check)
  // Populated by handleESignWebhook and getESignDoc after signing completes.
  // esignValidationVerdict: 'MATCH' | 'MISMATCH' | 'INSUFFICIENT_DATA'
  // esignValidationDetail:  full EsignValidationResult JSON for audit/compliance
  esignValidationVerdict String? // 'MATCH' | 'MISMATCH' | 'INSUFFICIENT_DATA'
  esignValidationDetail  Json? // full EsignValidationResult, for audit trail

  // Historical Revenue Share Snapshot (frozen at checkout)
  revenueSharePercentage Float?
  incentivePercentage    Float?
  lendingPrice           Float? // Historical Lending Price Snapshot (frozen at checkout)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([stockId])
  @@index([basketId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([cashfreeOrderId])
  @@index([status, expiresAt])
  @@index([couponId])
}

// ============================================
// PAYMENT ATTEMPT MODEL
// ============================================
enum PaymentAttemptStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  USER_DROPPED
  SUPERSEDED
}

// Durable integration work is inserted in the same transaction as business state.
model IntegrationTask {
  id          String    @id
  kind        String
  entityId    String
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  leaseToken  String?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([kind, completedAt, availableAt])
}

model VoucherSequence {
  prefix String @id
  value  BigInt
}

model PaymentAttempt {
  id               String               @id @default(cuid())
  orderId          String
  order            Order                @relation(fields: [orderId], references: [id])
  cashfreeOrderId  String               @unique
  paymentSessionId String?
  status           PaymentAttemptStatus @default(PENDING)
  amount           Decimal // snapshot at creation, for reconciliation
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([orderId, status])
}

// ============================================
// PORTFOLIO MODEL - User Stock Holdings
// ============================================
model Portfolio {
  id String @id @default(cuid())

  // Portfolio Details
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Portfolio stores the internal stock relation so holdings remain stable
  // even after business-identifier changes.
  stockId  String
  stock    Stock  @relation(fields: [stockId], references: [id])
  quantity Int
  avgPrice Float // Average purchase price

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, stockId])
  @@index([userId])
  @@index([stockId])
}

model WatchlistItem {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Support both regular and upcoming stocks.
  // IMPORTANT:
  // - DB-level XOR is enforced via a Postgres CHECK constraint added in a migration.
  // - Exactly one of `stockId` or `upcomingStockId` must be non-null.
  // - We also use `onDelete: Cascade` to avoid leaving dangling watchlist rows.
  stockId String?
  stock   Stock?  @relation(fields: [stockId], references: [id], onDelete: Cascade)

  upcomingStockId String?
  upcomingStock   UpcomingStock? @relation(fields: [upcomingStockId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([userId, stockId])
  @@unique([userId, upcomingStockId])
  @@index([userId])
  @@index([stockId])
  @@index([upcomingStockId])
}

// ============================================
// NEWS MODEL - News Articles
// ============================================
model News {
  id String @id @default(cuid())

  // News Details
  title        String
  content      String        @db.Text
  imageUrl     String?
  category     String? // News category (e.g., "Market", "IPO", "Company")
  isActive     Boolean       @default(true)
  stockId      String?
  stock        Stock?        @relation(fields: [stockId], references: [id])
  contentLikes ContentLike[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
  @@index([category])
}

// ============================================
// ARTICLE MODEL - Article Posts (formerly Blog)
// ============================================
model Article {
  id String @id @default(cuid())

  // Article Details
  title        String
  content      String        @db.Text
  imageUrl     String?
  category     String? // Article category (e.g., "Educational", "Insight", "Analysis")
  isActive     Boolean       @default(true)
  stockId      String?
  stock        Stock?        @relation(fields: [stockId], references: [id])
  contentLikes ContentLike[]

  // SEO / answer-engine fields. Kept nullable so existing articles keep
  // working: when `slug` is null the public URL falls back to slugify(title).
  slug              String?   @unique
  summary           String?   @db.Text // 120-150 word extractable answer
  keyFacts          Json? // [{ label, value }]
  authorName        String?
  authorRole        String?
  authorBio         String?   @db.Text
  reviewedBy        String?
  contentReviewedAt DateTime? // honest dateModified for crawlers

  faqs ArticleFaq[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
  @@index([category])
  @@index([stockId])
}

// ============================================
// ARTICLE FAQ MODEL - Per-article Q&A
// ============================================
// Separate from `Faq`, which is stock-scoped and feeds the stock-detail page.
model ArticleFaq {
  id String @id @default(cuid())

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  question String @db.Text
  answer   String @db.Text
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
}

// ============================================
// CONTENT LIKE MODEL - User Liked News & Articles
// ============================================
model ContentLike {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType String // "news" | "article"
  newsId      String?
  news        News?    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  articleId   String?
  article     Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, contentType, newsId])
  @@unique([userId, contentType, articleId])
  @@index([userId])
  @@index([contentType])
}

// ============================================
// FAQ MODEL - Frequently Asked Questions
// ============================================
model Faq {
  id String @id @default(cuid())

  // FAQ Details
  title    String
  answer   String  @db.Text
  category String
  isActive Boolean @default(true)
  stockId  String?
  stock    Stock?  @relation(fields: [stockId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
  @@index([category])
  @@index([stockId])
}

// ============================================
// BRANCH & INTERNAL RM MODELS
// ============================================
model Branch {
  id           String @id @default(cuid())
  name         String
  email        String // Not unique: one Branch Manager email may own several branches
  passwordHash String
  status       String @default("ACTIVE") // ACTIVE, INACTIVE

  // Classification: EQUITY, DISTRIBUTION, WEALTH, stocksKART, OTHER
  classification      String?
  classificationLabel String? // Custom label when classification = OTHER ("Add New")
  zone                String? // EQUITY
  zonalHead           String? // EQUITY
  areaManager         String? // EQUITY
  branchManager       String? // EQUITY
  territory           String? // DISTRIBUTION
  territoryHead       String? // DISTRIBUTION
  reportingManager    String? // WEALTH, stocksKART, OTHER

  internalRMs InternalRM[]

  hashedRefreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

